{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "replicaCount", "service", "ingress", "cluster", "auth", "state", "rbac", "resources", "podSecurityContext", "containerSecurityContext", "nodeSelector", "tolerations", "affinity"],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "replicaCount": {"type": "integer", "minimum": 1, "maximum": 1},
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "port"],
      "properties": {
        "type": {"enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "ingressClassName", "annotations", "hosts", "paths", "tls"],
      "properties": {
        "enabled": {"type": "boolean"},
        "ingressClassName": {"type": "string"},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}},
        "hosts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "pathType"],
            "properties": {
              "path": {"type": "string", "pattern": "^/"},
              "pathType": {"enum": ["Exact", "Prefix", "ImplementationSpecific"]}
            }
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["secretName", "hosts"],
            "properties": {
              "secretName": {"type": "string", "minLength": 1},
              "hosts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
            }
          }
        }
      }
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "region"],
      "properties": {"name": {"type": "string", "minLength": 1}, "region": {"type": "string", "minLength": 1}}
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "adminTokenSecret", "oidc"],
      "properties": {
        "mode": {"enum": ["token", "oidc"]},
        "adminTokenSecret": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "key"],
          "properties": {"name": {"type": "string"}, "key": {"type": "string", "minLength": 1}}
        },
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "required": ["issuer", "publicOrigin", "clientID", "clientSecret", "scopes", "groupsClaim", "rolePolicy"],
          "properties": {
            "issuer": {"type": "string", "pattern": "^$|^https://[^/?#@\\s]+(/[^?#\\s]*)?$"},
            "publicOrigin": {"type": "string", "pattern": "^$|^https://[^/?#@\\s]+$"},
            "clientID": {"type": "string"},
            "clientSecret": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "key"],
              "properties": {"name": {"type": "string"}, "key": {"type": "string", "minLength": 1}}
            },
            "scopes": {
              "type": "array", "minItems": 1, "uniqueItems": true, "contains": {"const": "openid"},
              "items": {"type": "string", "pattern": "^[^\\s]+$", "not": {"const": "offline_access"}}
            },
            "groupsClaim": {"type": "string", "minLength": 1, "pattern": "\\S"},
            "rolePolicy": {
              "type": "object",
              "additionalProperties": false,
              "required": ["adminSubjects", "viewerSubjects", "adminGroups", "viewerGroups"],
              "properties": {
                "adminSubjects": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "\\S"}},
                "viewerSubjects": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "\\S"}},
                "adminGroups": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "\\S"}},
                "viewerGroups": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "\\S"}}
              }
            }
          }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["persistence"],
      "properties": {
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "size"],
          "properties": {"enabled": {"type": "boolean"}, "size": {"type": "string", "minLength": 1}, "storageClass": {"type": ["string", "null"]}}
        }
      }
    },
    "rbac": {"type": "object", "additionalProperties": false, "required": ["create"], "properties": {"create": {"type": "boolean"}}},
    "resources": {"type": "object"},
    "podSecurityContext": {"type": "object"},
    "containerSecurityContext": {"type": "object"},
    "nodeSelector": {"type": "object"},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"}
  }
}
